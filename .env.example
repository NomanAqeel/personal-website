# Public site URL used for canonical links, sitemap, and Open Graph.
# Optional: on Vercel it defaults to the project's production URL (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the contact form (https://web3forms.com - free, emailed to you).
# Without it, the form falls back to opening the visitor's mail app.
NEXT_PUBLIC_WEB3FORMS_KEY=
